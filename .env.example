# Runtime API connection: NON-owner, NOBYPASSRLS role
DATABASE_URL=postgres://hrms_app:change_me_app@localhost:5432/hrms
# Outbox worker connection
OUTBOX_DATABASE_URL=postgres://hrms_worker:change_me_worker@localhost:5432/hrms
JWT_SECRET=replace-with-32+-random-bytes
JWT_ISSUER=hrms-api
JWT_AUDIENCE=hrms-web
ACCESS_TOKEN_TTL_SECONDS=900
PORT=4000

# --- setup / tests only -------------------------------------------------
# Superuser connection used by `npm run db:reset` (points at the `postgres` db)
ADMIN_DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/postgres
DB_NAME=hrms
OWNER_PASSWORD=change_me_owner
APP_PASSWORD=change_me_app
WORKER_PASSWORD=change_me_worker
# Superuser connection to the app db, used by the integration tests only
TEST_ADMIN_DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/hrms
