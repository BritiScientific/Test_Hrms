{
  "name": "hrms-rbac-workflow",
  "version": "0.1.0",
  "description": "Multi-tenant HRMS: RBAC, workflow engine, leave management",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:reset": "node scripts/db-reset.mjs",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "test": "node --env-file=.env --import tsx --test --test-concurrency=1 --test-reporter=spec test/*.test.ts",    "outbox": "tsx src/modules/outbox/outbox.worker.ts",
    "tenant:provision": "tsx src/cli/tenant-cli.ts create",
    "tenant:invite": "tsx src/cli/tenant-cli.ts invite",
    "web:install": "npm --prefix frontend install",
    "web:dev": "npm --prefix frontend run dev",
    "web:build": "npm --prefix frontend run build",
    "web:test": "npm --prefix frontend test",
    "db:reset:bash": "./scripts/reset-db.sh"
  },
  "private": true,
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
